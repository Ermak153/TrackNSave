<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003" ToolsVersion="4.0">
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
    <SchemaVersion>2.0</SchemaVersion>
    <ProjectGuid>f2a30683-6c43-4577-9ff6-60ac22e334d5</ProjectGuid>
    <ProjectHome>.</ProjectHome>
    <StartupFile>main.py</StartupFile>
    <WorkingDirectory>.</WorkingDirectory>
    <OutputPath>.</OutputPath>
    <Name>tracknsave.ai</Name>
    <RootNamespace>tracknsave.ai</RootNamespace>
    <BuildProject>false</BuildProject>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    <Dockerfile>Dockerfile</Dockerfile>
    <DockerServiceName>tracknsave.ai</DockerServiceName>
    <SuppressEnvironmentCreationPrompt>True</SuppressEnvironmentCreationPrompt>
  </PropertyGroup>
  <Target Name="DockerResolveAppType">
    <Message Text="Stub" Importance="low" />
    <PropertyGroup>
      <AppProjectType>python</AppProjectType>
    </PropertyGroup>
  </Target>
  <Target Name="DockerResolveTargetFramework">
    <Message Text="Stub" Importance="low" />
    <PropertyGroup>
      <TargetFramework>netstandard2.0</TargetFramework>
    </PropertyGroup>
  </Target>
  <Target Name="DockerResolveTargetFrameworkVersion">
    <Message Text="Stub" Importance="low" />
    <PropertyGroup>
      <TargetFrameworkVersion>v2.0</TargetFrameworkVersion>
    </PropertyGroup>
  </Target>
  <Target Name="DockerUpdateComposeVsGeneratedFiles">
    <Message Text="Stub" Importance="low" />
  </Target>
  <ItemGroup>
    <Compile Include="main.py" />
    <Compile Include="train.py" />
  </ItemGroup>
  <ItemGroup>
    <Folder Include="models\" />
    <Folder Include="models\xlm-roberta-large\" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="dataset.csv" />
    <Content Include="Dockerfile" />
    <Content Include="models\xlm-roberta-large\config.json" />
    <Content Include="models\xlm-roberta-large\label_encoder.pkl" />
    <Content Include="models\xlm-roberta-large\model.safetensors" />
    <Content Include="models\xlm-roberta-large\sentencepiece.bpe.model" />
    <Content Include="models\xlm-roberta-large\special_tokens_map.json" />
    <Content Include="models\xlm-roberta-large\tokenizer_config.json" />
    <Content Include="requirements.txt" />
  </ItemGroup>
</Project>